# Copy this file to .env for local development. Never commit .env.
{{ cookiecutter.project_slug | upper }}_LOG_LEVEL=INFO
{% set interface_types = namespace(values=[]) %}
{% for interface in cookiecutter.interfaces.entries %}
{% if interface.type is defined and interface.type %}
{% set _ = interface_types.values.append(interface.type) %}
{% endif %}
{% endfor %}
{% set has_http_interface = "Web API" in interface_types.values or "SPARQL endpoint" in interface_types.values or "Web service" in interface_types.values or "Bioinformatics portal" in interface_types.values or "Database portal" in interface_types.values or "Web application" in interface_types.values or "Workbench" in interface_types.values %}
{% set has_openapi_interface = "Web API" in interface_types.values or "SPARQL endpoint" in interface_types.values or "Bioinformatics portal" in interface_types.values or "Database portal" in interface_types.values or "Web application" in interface_types.values or "Workbench" in interface_types.values %}
{% if has_http_interface %}

# HTTP server binding. Keep the loopback default for local development.
{{ cookiecutter.project_slug | upper }}_SERVER_HOST=127.0.0.1
{{ cookiecutter.project_slug | upper }}_SERVER_PORT=8000
{{ cookiecutter.project_slug | upper }}_SERVER_ROOT_PATH=
{{ cookiecutter.project_slug | upper }}_SERVER_RELOAD=false
{% if has_openapi_interface %}

# Set this when the public URL differs from the bind address, for example when
# deploying behind a reverse proxy. It is published in OpenAPI metadata.
# {{ cookiecutter.project_slug | upper }}_PUBLIC_BASE_URL=https://example.org
{% endif %}
{% endif %}
{% if "Secrets management (e.g., environment variables, vault)" in cookiecutter.security_measures.selected.entries %}

# Add project-specific secret fields to Settings, then provide their values
# through local environment variables or the selected secrets manager.
{% endif %}
